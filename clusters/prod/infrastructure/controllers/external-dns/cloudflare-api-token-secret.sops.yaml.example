---
# TEMPLATE — do not commit unencrypted. Copy without the .example suffix,
# fill in the token (Zone:DNS:Edit for cpdevlab.com), then:
#   sops -e -i cloudflare-api-token-secret.sops.yaml
# and uncomment the entry in kustomization.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
  namespace: external-dns
type: Opaque
stringData:
  api-token: REPLACE_ME
