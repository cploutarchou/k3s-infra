---
# TEMPLATE — do not commit unencrypted. Same Cloudflare token as
# external-dns but living in the cert-manager namespace (DNS-01 solver
# reads it there). Copy without .example, fill in, then:
#   sops -e -i cloudflare-api-token-secret.sops.yaml
# and uncomment the entry in kustomization.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
  namespace: cert-manager
type: Opaque
stringData:
  api-token: REPLACE_ME
