---
# TEMPLATE — do not commit unencrypted. R2 API token with object write on
# bucket k3s-backups (EU jurisdiction). Copy without .example, fill in, then:
#   sops -e -i r2-backup-credentials.sops.yaml
# and uncomment the entry in kustomization.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: r2-backup-credentials
  namespace: databases
type: Opaque
stringData:
  ACCESS_KEY_ID: REPLACE_ME
  SECRET_ACCESS_KEY: REPLACE_ME
