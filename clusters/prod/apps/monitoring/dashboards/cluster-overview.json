     "expr": "(sum(kube_pod_status_phase{phase=~\"Pending|Unknown\"} == 1) or vector(0)) + (sum(kube_pod_status_phase{phase=\"Failed\"} == 1 unless on(namespace,pod) kube_pod_owner{owner_kind=\"Job\"}) or vector(0))",
     "refId": "A"
