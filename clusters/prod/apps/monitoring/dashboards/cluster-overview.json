  {
   "type": "row",
   "title": "Capacity (2/3 rule: requests must stay under 66.7% so two nodes absorb the loss of one)",
   "collapsed": false,
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 9
   },
   "panels": [],
   "id": 14
  },
  {
   "type": "gauge",
   "title": "CPU requested / allocatable",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "w": 6,
    "h": 6,
    "x": 0,
    "y": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(kube_pod_container_resource_requests{resource=\"cpu\"} * on(namespace,pod) group_left() max by(namespace,pod)(kube_pod_status_phase{phase=~\"Running|Pending\"} == 1)) / sum(kube_node_status_allocatable{resource=\"cpu\"})",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.55
       },
       {
        "color": "red",
        "value": 0.667
       }
      ]
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "showThresholdMarkers": true
   },
   "id": 15
  },
  {
   "type": "gauge",
   "title": "Memory requested / allocatable",
   "datasource": {
    "type": "prometheus",
