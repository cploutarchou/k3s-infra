    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "description": "Pending or Unknown pods, plus Failed pods that are not Job pods. Failed Job pods show up per app under Jobs and CronJobs on the Applications dashboard.",
