     "refId": "A",
     "format": "table",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "used %"
