{
 "uid": "k3s-databases",
 "title": "k3s Databases (CNPG) and Backups",
 "tags": [
  "k3s-infra"
 ],
 "editable": true,
 "schemaVersion": 39,
 "timezone": "browser",
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datname",
    "label": "database",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "victoriametrics"
    },
    "refresh": 2,
    "query": {
     "query": "label_values(cnpg_backends_total, datname)",
     "refId": "datname"
    },
    "includeAll": true,
    "multi": true,
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Cluster: postgres (1 primary + 2 replicas, one per node)",
   "collapsed": false,
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 0
   },
   "panels": [],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Primary",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "w": 4,
    "h": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "cnpg_pg_replication_in_recovery{job=\"cnpg\"} == 0",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "displayName": "${__field.labels.pod}"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "name"
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "Streaming replicas",
