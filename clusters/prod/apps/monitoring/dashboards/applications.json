  {
   "type": "row",
   "title": "Pods",
   "collapsed": false,
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 20
   },
   "panels": [],
   "id": 17
  },
  {
   "type": "timeseries",
   "title": "CPU per pod vs requests/limits",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "w": 8,
    "h": 8,
    "x": 0,
    "y": 21
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum by(pod)(rate(container_cpu_usage_seconds_total{job=\"cadvisor\",namespace=\"$app\",container!=\"\"}[5m]))",
     "refId": "A",
     "legendFormat": "{{pod}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(kube_pod_container_resource_requests{namespace=\"$app\",resource=\"cpu\"} * on(namespace,pod) group_left() max by(namespace,pod)(kube_pod_status_phase{phase=\"Running\"} == 1))",
     "refId": "B",
     "legendFormat": "requests (running pods)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(kube_pod_container_resource_limits{namespace=\"$app\",resource=\"cpu\"} * on(namespace,pod) group_left() max by(namespace,pod)(kube_pod_status_phase{phase=\"Running\"} == 1))",
     "refId": "C",
     "legendFormat": "limits (running pods)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "cores",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*limit.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*request.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dot",
         "dash": [
          2,
          4
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 18
  },
  {
