     },
     "expr": "sum by(pod)(container_memory_working_set_bytes{job=\"cadvisor\",namespace=\"$app\",container!=\"\"})",
     "refId": "A",
     "legendFormat": "{{pod}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(kube_pod_container_resource_requests{namespace=\"$app\",resource=\"memory\"} * on(namespace,pod) group_left() max by(namespace,pod)(kube_pod_status_phase{phase=\"Running\"} == 1))",
     "refId": "B",
     "legendFormat": "requests (running pods)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(kube_pod_container_resource_limits{namespace=\"$app\",resource=\"memory\"} * on(namespace,pod) group_left() max by(namespace,pod)(kube_pod_status_phase{phase=\"Running\"} == 1))",
     "refId": "C",
     "legendFormat": "limits (running pods)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*limit.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*request.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dot",
         "dash": [
          2,
          4
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     }
    ]
   },
