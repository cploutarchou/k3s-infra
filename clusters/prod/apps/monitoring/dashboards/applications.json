   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(rate(traefik_service_requests_total{job=\"traefik\",service=~\"$app-.*@kubernetes\",code=~\"4..\"}[5m]))",
     "refId": "A",
     "legendFormat": "4xx"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
