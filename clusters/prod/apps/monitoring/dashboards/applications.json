{
 "uid": "k3s-applications",
 "title": "k3s Applications",
 "tags": [
  "k3s-infra"
 ],
 "editable": true,
 "schemaVersion": 39,
 "timezone": "browser",
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "app",
    "label": "application",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "victoriametrics"
    },
    "refresh": 2,
    "query": {
     "query": "label_values(kube_pod_info, namespace)",
     "refId": "app"
    },
    "includeAll": false,
    "multi": false,
    "current": {
     "selected": true,
     "text": "website",
     "value": "website"
    },
    "sort": 1,
    "regex": "/^(executionlab-staging|executionlab-site|website|gvasiliourolex|signwise|mailnexus|mcp|monitoring)$/"
   },
   {
    "name": "db",
    "label": "database",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "victoriametrics"
    },
    "refresh": 2,
    "query": {
     "query": "label_values(cnpg_pg_database_size_bytes, datname)",
     "refId": "db"
    },
    "includeAll": true,
    "multi": true,
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    },
    "sort": 1,
    "regex": "/^(website|gvasiliourolex|signwise|executionlab_staging_.*)$/"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "$app \u2014 health",
   "collapsed": false,
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 0
   },
   "panels": [],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Pods ready / desired",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "w": 3,
    "h": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(kube_deployment_status_replicas_ready{namespace=\"$app\"})",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "displayName": "ready"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "Desired",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "w": 3,
    "h": 4,
    "x": 3,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(kube_deployment_status_replicas{namespace=\"$app\"})",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "Restarts (24h)",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "w": 3,
    "h": 4,
    "x": 6,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$app\"}[24h])) or vector(0)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "id": 4
  },
  {
   "type": "stat",
   "title": "OOM kills (last termination)",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "w": 3,
    "h": 4,
    "x": 9,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(kube_pod_container_status_last_terminated_reason{namespace=\"$app\",reason=\"OOMKilled\"}) or vector(0)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "id": 5
  },
  {
   "type": "stat",
   "title": "Requests/s",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "w": 3,
    "h": 4,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(rate(traefik_service_requests_total{job=\"traefik\",service=~\"$app-.*@kubernetes\"}[5m]))",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "id": 6
  },
  {
   "type": "stat",
   "title": "5xx ratio (5m)",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "w": 3,
    "h": 4,
    "x": 15,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(rate(traefik_service_requests_total{job=\"traefik\",service=~\"$app-.*@kubernetes\",code=~\"5..\"}[5m])) / sum(rate(traefik_service_requests_total{job=\"traefik\",service=~\"$app-.*@kubernetes\"}[5m]))",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.01
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "id": 7
  },
  {
   "type": "stat",
   "title": "p95 latency",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "w": 3,
    "h": 4,
    "x": 18,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "histogram_quantile(0.95, sum by(le)(rate(traefik_service_request_duration_seconds_bucket{job=\"traefik\",service=~\"$app-.*@kubernetes\"}[5m])))",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "id": 8
  },
  {
   "type": "stat",
   "title": "Cert time left",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "w": 3,
    "h": 4,
    "x": 21,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "min(certmanager_certificate_expiration_timestamp_seconds{namespace=\"$app\"} - time())",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 604800
       },
       {
        "color": "green",
        "value": 1728000
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "id": 9
  },
  {
