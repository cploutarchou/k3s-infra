# Plunk's secrets, read through envFrom by the plunk Deployment (and
# DB_PASSWORD by postgres and the backup job). The encrypted file is
# mailnexus-secrets.sops.yaml; change a value with
#   sops set --value-stdin clusters/prod/apps/mailnexus/mailnexus-secrets.sops.yaml '["stringData"]["<KEY>"]'
# (the value on stdin, JSON-encoded), then bump mailnexus.io/config-revision
# in plunk.yaml so Plunk restarts and reads it.
#   AWS_SES_*: the least-privilege SES sender IAM user.
#   DB_PASSWORD: the plunk role's password; DATABASE_URL and
#     DIRECT_DATABASE_URL embed it (postgresql://plunk:<pw>@postgres:5432/plunk).
#   JWT_SECRET: dashboard session signing key; rotating it logs everyone out.
#   S3_ACCESS_KEY_*: an R2 API token scoped to bucket mailnexus-uploads,
#     Object Read & Write.
apiVersion: v1
kind: Secret
metadata:
  name: mailnexus-secrets
  namespace: mailnexus
type: Opaque
stringData:
  AWS_SES_ACCESS_KEY_ID: '<SES sender access key id>'
  AWS_SES_SECRET_ACCESS_KEY: '<SES sender secret access key>'
  DATABASE_URL: 'postgresql://plunk:<DB_PASSWORD>@postgres:5432/plunk'
  DB_PASSWORD: '<database password>'
  DIRECT_DATABASE_URL: 'postgresql://plunk:<DB_PASSWORD>@postgres:5432/plunk'
  JWT_SECRET: '<random 32 bytes, base64>'
  S3_ACCESS_KEY_ID: '<Access Key ID of the mailnexus-uploads R2 token>'
  S3_ACCESS_KEY_SECRET: '<Secret Access Key of the mailnexus-uploads R2 token>'
