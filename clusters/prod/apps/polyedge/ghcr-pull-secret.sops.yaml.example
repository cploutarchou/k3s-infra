# Pull secret for the private ghcr.io/cploutarchou/polyedge image, the same
# shape as website/ghcr-pull-secret.sops.yaml (a classic PAT with
# read:packages). Reusing the website token for this namespace:
#
#   sops -d clusters/prod/apps/website/ghcr-pull-secret.sops.yaml \
#     | sed 's/namespace: website/namespace: polyedge/' \
#     > /dev/shm/ghcr-pull.yaml
#   sops --encrypt --filename-override clusters/prod/apps/polyedge/ghcr-pull-secret.sops.yaml \
#     /dev/shm/ghcr-pull.yaml > clusters/prod/apps/polyedge/ghcr-pull-secret.sops.yaml
#   shred -u /dev/shm/ghcr-pull.yaml
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull
  namespace: polyedge
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: '{"auths":{"ghcr.io":{"auth":"<base64 of user:token>"}}}'
